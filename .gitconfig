[user]
	name = Edward Tan
	email = edwardjtan.dev@gmail.com
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[alias]
	co = checkout
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = false
	syntax-theme = Nord
	dark = true
	minus-style = syntax "#3b3038"
	plus-style = syntax "#343e36"
	minus-emph-style = syntax "#573e49"
	plus-emph-style = syntax "#465540"
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
	autoUpdate = true
