{
  "settings": {
    "autoAuth": true
  },
  "mcpServers": {
    "meju": {
      "url": "https://www.meju.app/mcp",
      "oauth": {
        "clientRegistration": "cimd"
      },
      "description": "Meju recipe application MCP server"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.81",
        "--executable-path",
        "/usr/bin/chromium",
        "--user-data-dir",
        "~/.local/share/pi/playwright-profile",
        "--output-dir",
        "/tmp/pi-playwright-etan"
      ]
    },
    "opgg": {
      "url": "https://mcp-api.op.gg/mcp",
      "exposure": "codemode",
      "description": "OP.GG League of Legends champion stats, builds, counter matchups, lane meta and player data"
    }
  }
}
