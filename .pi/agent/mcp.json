{
  "settings": {
    "autoAuth": true
  },
  "mcpServers": {
    "meju": {
      "url": "https://www.meju.app/mcp",
      "oauth": { "clientRegistration": "cimd" },
      "description": "Meju recipe application MCP server"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.81",
        "--executable-path",
        "/usr/bin/chromium",
        "--user-data-dir",
        "~/.local/share/pi/playwright-profile",
        "--output-dir",
        "/tmp/pi-playwright-etan"
      ]
    }
  }
}
