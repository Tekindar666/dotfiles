{
  "settings": {
    "autoAuth": true
  },
  "mcpServers": {
    "linear": {
      "url": "https://mcp.linear.app/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.81",
        "--executable-path",
        "/usr/bin/chromium",
        "--user-data-dir",
        "~/.local/share/pi/playwright-profile",
        "--output-dir",
        "/tmp/pi-playwright-etan"
      ]
    }
  }
}
