# Font
font-family = JetBrainsMono NFM SemiBold
font-size = 14
font-thicken = false

# Window
window-decoration = false
macos-titlebar-style = hidden
background-opacity = 0.9
window-padding-x = 5
window-padding-y = 5

# Shell integration
shell-integration = detect

# Nord colorscheme
