#!/bin/sh

set -eu

if ! command -v fzf >/dev/null 2>&1; then
    tmux display-message "fzf is required for the session picker"
    exit 0
fi

selected=$(
    tmux list-sessions -F '#{session_id}	#{session_name}	#{session_attached}' |
        awk -F '\t' '
            BEGIN { OFS = "\t" }
            {
                marker = $3 != "0" ? "●" : " "
                printf "%s\t%s  %s\n", $1, marker, $2
            }
        ' |
        fzf \
            --delimiter='\t' \
            --with-nth=2 \
            --no-sort \
            --cycle \
            --info=hidden \
            --no-separator \
            --layout=reverse \
            --prompt='Switch to › ' \
            --pointer='›' \
            --marker='●' \
            --color='fg:#d8dee9,bg:#2e3440,fg+:#2e3440,bg+:#81A1C1' \
            --color='hl:#81A1C1,hl+:#2e3440,prompt:#81A1C1,pointer:#81A1C1' \
            --color='marker:#81A1C1,spinner:#81A1C1,gutter:#2e3440'
)

[ -n "$selected" ] || exit 0

session_id=$(printf '%s' "$selected" | cut -f1)

tmux switch-client -t "$session_id"
